<?xml version="1.0"?>
<robot name="autonomous_rover">
  <link name="base_link">
    <visual><geometry><box size="0.4 0.3 0.1"/></geometry><material name="gray"><color rgba="0.5 0.5 0.5 1"/></material></visual>
    <collision><geometry><box size="0.4 0.3 0.1"/></geometry></collision>
    <inertial><mass value="5.0"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/></inertial>
  </link>
  <gazebo reference="base_link"><material>Gazebo/Grey</material></gazebo>

  <link name="left_wheel">
    <visual><origin rpy="1.5707 0 0"/><geometry><cylinder radius="0.05" length="0.04"/></geometry></visual>
    <collision><origin rpy="1.5707 0 0"/><geometry><cylinder radius="0.05" length="0.04"/></geometry></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.17 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <gazebo reference="left_wheel"><material>Gazebo/Black</material></gazebo>

  <link name="right_wheel">
    <visual><origin rpy="1.5707 0 0"/><geometry><cylinder radius="0.05" length="0.04"/></geometry></visual>
    <collision><origin rpy="1.5707 0 0"/><geometry><cylinder radius="0.05" length="0.04"/></geometry></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.17 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <gazebo reference="right_wheel"><material>Gazebo/Black</material></gazebo>

  <link name="camera_link">
    <visual><geometry><box size="0.02 0.1 0.03"/></geometry></visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.18 0 0.06" rpy="0 0 0"/>
  </joint>
  <gazebo reference="camera_link"><material>Gazebo/Blue</material></gazebo>

  <link name="arm_base_link">
    <visual><geometry><cylinder radius="0.05" length="0.02"/></geometry></visual>
    <inertial><mass value="0.2"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="arm_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base_link"/>
    <origin xyz="0.05 0 0.06" rpy="0 0 0"/>
  </joint>
  <gazebo reference="arm_base_link"><material>Gazebo/DarkGrey</material></gazebo>

  <link name="arm_link1">
    <visual><origin xyz="0 0 0.02"/><geometry><cylinder radius="0.04" length="0.04"/></geometry></visual>
    <inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="joint1_pan" type="revolute">
    <parent link="arm_base_link"/>
    <child link="arm_link1"/>
    <origin xyz="0 0 0.01" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  </joint>
  <gazebo reference="arm_link1"><material>Gazebo/Black</material><gravity>false</gravity></gazebo>

  <link name="arm_link2">
    <visual><origin xyz="0 0 0.05"/><geometry><box size="0.03 0.03 0.1"/></geometry></visual>
    <inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="joint2_shoulder" type="revolute">
    <parent link="arm_link1"/>
    <child link="arm_link2"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  </joint>
  <gazebo reference="arm_link2"><material>Gazebo/DarkGrey</material><gravity>false</gravity></gazebo>

  <link name="arm_link3">
    <visual><origin xyz="0 0 0.05"/><geometry><box size="0.025 0.025 0.1"/></geometry></visual>
    <inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="joint3_elbow" type="revolute">
    <parent link="arm_link2"/>
    <child link="arm_link3"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  </joint>
  <gazebo reference="arm_link3"><material>Gazebo/Black</material><gravity>false</gravity></gazebo>

  <link name="arm_link4">
    <visual><origin xyz="0 0 0.025"/><geometry><box size="0.02 0.02 0.05"/></geometry></visual>
    <inertial><mass value="0.05"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="joint4_wrist" type="revolute">
    <parent link="arm_link3"/>
    <child link="arm_link4"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  </joint>
  <gazebo reference="arm_link4"><material>Gazebo/DarkGrey</material><gravity>false</gravity></gazebo>

  <link name="gripper_link">
    <visual><origin xyz="0 0 0.01"/><geometry><box size="0.04 0.04 0.02"/></geometry></visual>
    <inertial><mass value="0.05"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="joint5_gripper" type="revolute">
    <parent link="arm_link4"/>
    <child link="gripper_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  </joint>
  <gazebo reference="gripper_link"><material>Gazebo/Red</material><gravity>false</gravity></gazebo>

  <gazebo>
    <plugin name="skid_steer_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><remapping>cmd_vel:=cmd_vel</remapping></ros>
      <update_rate>30</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.34</wheel_separation>
      <wheel_diameter>0.1</wheel_diameter>
      <command_topic>cmd_vel</command_topic>
    </plugin>
    <plugin name="gazebo_ros_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros><remapping>~/out:=joint_states</remapping></ros>
      <update_rate>30</update_rate>
      <joint_name>joint1_pan</joint_name>
      <joint_name>joint2_shoulder</joint_name>
      <joint_name>joint3_elbow</joint_name>
      <joint_name>joint4_wrist</joint_name>
      <joint_name>joint5_gripper</joint_name>
    </plugin>
    <plugin name="gazebo_ros_joint_pose_trajectory" filename="libgazebo_ros_joint_pose_trajectory.so">
      <ros><remapping>set_joint_trajectory:=set_joint_trajectory</remapping></ros>
      <update_rate>10</update_rate>
    </plugin>
  </gazebo>
</robot>
